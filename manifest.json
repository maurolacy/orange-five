{
  "manifest_version": 3,
  "name": "Pool Ball Color Restoration",
  "version": "2.0.0",
  "description": "Best-effort WebGL remap: TV purple 5-ball → orange, pink 4-ball → purple.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pool Color Restorer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
